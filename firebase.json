{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "bts-delivery-app",
          "appId": "1:888040429479:android:c25da56e17aa73939c4882"
        }
      },
      "ios": {
        "default": {
          "projectId": "bts-delivery-app",
          "appId": "1:888040429479:ios:90690ddfe04f29f59c4882",
          "uploadDebugSymbols": true
        }
      }
    }
  }
}
