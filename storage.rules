rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function staffCanAccess(schoolId, staffId, managementRequired) {
      let staff = firestore.get(/databases/(default)/documents/staff/$(staffId)).data;
      return staff != null && staff.get('uid', null) == request.auth.uid &&
        (staff.role in ['admin', 'manager'] || (!managementRequired && staff.role == 'staff' &&
          staff.get('assignedSchoolIds', []) is list &&
          schoolId in staff.get('assignedSchoolIds', [])));
    }

    function linkedSchoolAccess(schoolId, managementRequired) {
      let mapping = firestore.get(/databases/(default)/documents/staff_access/$(request.auth.uid)).data;
      return mapping != null && staffCanAccess(schoolId, mapping.staffId, managementRequired);
    }

    function canAccess(schoolId, managementRequired) {
      return request.auth != null && linkedSchoolAccess(schoolId, managementRequired);
    }

    function ownedImage(contentType) {
      return resource == null &&
        request.resource.metadata.get('uploadedBy', null) == request.auth.uid &&
        request.resource.metadata.get('sha256', '').matches('^[a-f0-9]{64}$') &&
        request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType == contentType;
    }

    match /schools/{schoolId}/{path=**} {
      allow read: if canAccess(schoolId, false);
    }

    match /schools/{schoolId}/yearLevels/{yearLevelId}/classrooms/{classroomId}/photos/{fileName} {
      allow create: if canAccess(schoolId, false) && ownedImage('image/jpeg') &&
        fileName.matches('^[a-f0-9-]{36}[.]jpg$');
    }

    match /deliveries/{deliveryId}/workspace/{schoolId}/yearLevels/{yearLevelId}/classrooms/{classroomId}/photos/{fileName} {
      allow read: if canAccess(schoolId, false);
      allow create: if canAccess(schoolId, false) && ownedImage('image/jpeg') &&
        fileName.matches('^[a-f0-9-]{36}[.]jpg$');
    }

    match /schools/{schoolId}/signoffs/{fileName} {
      allow create: if canAccess(schoolId, false) && ownedImage('image/png') &&
        fileName.matches('^[a-f0-9-]{36}[.]png$');
    }

    match /schools/{schoolId}/map/{fileName} {
      allow write: if canAccess(schoolId, true);
    }

    match /schools/{schoolId}/maps/{fileName} {
      allow write: if canAccess(schoolId, true);
    }

    // Optional school logo: a small JPEG managed by admins and managers.
    match /schools/{schoolId}/logo/{fileName} {
      allow create, update: if canAccess(schoolId, true) &&
        fileName.matches('^[a-f0-9-]{36}[.]jpg$') &&
        request.resource.contentType == 'image/jpeg' &&
        request.resource.size > 0 && request.resource.size <= 2 * 1024 * 1024;
      allow delete: if canAccess(schoolId, true) &&
        fileName.matches('^[a-f0-9-]{36}[.]jpg$');
    }
  }
}
